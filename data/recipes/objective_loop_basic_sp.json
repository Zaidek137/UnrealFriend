{
  "recipe_id": "objective_loop_basic_sp",
  "version": "1.0.0",
  "description": "Build a basic single-player objective loop with score and restart scaffolding.",
  "inputs": [
    {"name": "namespace_root", "type": "string", "required": false, "default": "/Game/AgentGenerated"},
    {"name": "controller_asset_name", "type": "string", "required": false, "default": "BP_AgentObjectiveController"},
    {"name": "widget_asset_name", "type": "string", "required": false, "default": "WBP_AgentObjectiveHUD"},
    {"name": "objective_count", "type": "integer", "required": false, "default": 3},
    {"name": "objective_base_location", "type": "vector3", "required": false, "default": [0, 0, 80]}
  ],
  "steps": [
    {"id": "create_controller", "action": "create_blueprint"},
    {"id": "wire_progress", "action": "wire_objective_progress"},
    {"id": "create_score", "action": "create_score_system"},
    {"id": "create_hud_widget", "action": "create_widget_blueprint"},
    {"id": "seed_hud_widget", "action": "modify_widget_tree"},
    {"id": "bind_hud_events", "action": "bind_widget_events"},
    {"id": "create_objective_N", "action": "create_objective_actor"}
  ],
  "post_validations": [
    {"kind": "compile_blueprint", "target": "controller"},
    {"kind": "assert_world_state", "required_tags": ["ObjectiveItem"]}
  ],
  "outputs": [
    "controller_blueprint_path",
    "hud_widget_path",
    "objective_actor_count"
  ]
}
